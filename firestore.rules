rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teams: create if authenticated; read if user is a member
    match /teams/{teamId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow delete: if false;
    }

    // Members: read if member of team; create only own doc (creator or Cloud Function adds others server-side)
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == memberId;
      allow update, delete: if false;
    }

    // Tasks: all members can read/create/update; only admins can delete
    match /teams/{teamId}/tasks/{taskId} {
      allow read, create, update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Invites: only Cloud Functions (admin SDK) manage invites; client has no access
    match /invites/{inviteId} {
      allow read, write: if false;
    }
  }
}
