rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teams: create if authenticated; read if user is a member
    match /teams/{teamId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow delete: if false;
    }

    // Members: read if member of team; create only own doc (creator or Cloud Function adds others server-side)
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == memberId;
      allow update, delete: if false;
    }

    // Tasks: all members can read/create/update; only admins can delete
    match /teams/{teamId}/tasks/{taskId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));

      // Create: must be a team member and `createdBy` must match the caller
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ["pending", "in_progress", "done"]
        && request.resource.data.title is string;

      // Update: admins can update any fields; members can only change `status` and `description` (not `title`)
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && (
          // Admins may update anything
          get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin'
          || (
            // Non-admins may only modify status and description and must not change title
            request.resource.data.title == resource.data.title
            && (request.resource.data.keys().hasOnly(['title','description','status','createdBy','createdAt','updatedAt']) || request.resource.data.keys().hasOnly(['description','status','updatedAt','title','createdBy','createdAt']))
            && request.resource.data.status in ["pending", "in_progress", "done"]
          )
        );

      // Delete: only admins
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Invites: only Cloud Functions (admin SDK) manage invites; client has no access
    match /invites/{inviteId} {
      allow read, write: if false;
    }
  }
}
